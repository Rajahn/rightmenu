				<key>AMName</key>
				<string>Run Shell Script</string>
				<key>AMProvides</key>
				<dict>
					<key>Container</key>
					<string>List</string>
					<key>Types</key>
					<array>
						<string>com.apple.cocoa.string</string>
					</array>
				</dict>
				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>finder_path() {
    /usr/bin/osascript &lt;&lt;'APPLESCRIPT'
tell application "Finder"
    if (count of Finder windows) &gt; 0 then
        set targetPath to POSIX path of (target of front Finder window as alias)
    else
        set targetPath to POSIX path of (desktop as alias)
    end if
end tell
APPLESCRIPT
}

absolute_path() {
    local item="$1"
    case "$item" in
        /*) printf '%s\n' "$item" ;;
        *) printf '%s\n' "$PWD/$item" ;;
    esac
}

target_dir_from_item_or_finder() {
    local item="${1:-}"
    if [ -z "$item" ]; then
        finder_path
        return
    fi

    item="$(absolute_path "$item")"
    if [ -f "$item" ]; then
        dirname "$item"
    else
        printf '%s\n' "$item"
    fi
}

shell_quote() {
    printf '%q' "$1"
}

open_terminal_at() {
    local target="$1"
    local escaped
    escaped="$(shell_quote "$target")"
    /usr/bin/osascript &lt;&lt;APPLESCRIPT
tell application "Terminal"
    activate
    do script "cd ${escaped}"
end tell
APPLESCRIPT
}

unique_file_path() {
    local dir="$1"
    local base="$2"
    local ext="$3"
    local candidate="$dir/$base.$ext"
    local index=2
    while [ -e "$candidate" ]; do
        candidate="$dir/$base $index.$ext"
        index=$((index + 1))
    done
    printf '%s\n' "$candidate"
}

open_editor_at() {
    local app_name="$1"
    local cli_name="$2"
    local target="$3"

    if command -v "$cli_name" &gt;/dev/null 2&gt;&amp;1; then
        "$cli_name" "$target" &gt;/dev/null 2&gt;&amp;1 &amp;
    else
        /usr/bin/open -a "$app_name" "$target"
    fi
}

git_root_for_path() {
    local item="$1"
    local dir
    item="$(absolute_path "$item")"
    if [ -d "$item" ]; then
        dir="$item"
    else
        dir="$(dirname "$item")"
    fi

    while [ "$dir" != "/" ]; do
        if [ -e "$dir/.git" ]; then
            printf '%s\n' "$dir"
            return 0
        fi
        dir="$(dirname "$dir")"
    done
    return 1
}

target="$(finder_path)"
open_editor_at "Visual Studio Code" "code" "$target"</string>
					<key>CheckedForUserDefaultShell</key>
					<true/>
					<key>inputMethod</key>
					<integer>0</integer>
					<key>shell</key>
